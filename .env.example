# ==============================================================================
# HB+ EMPLOYEE PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Expo SDK 58, all client-accessible environment variables MUST be prefixed
# with EXPO_PUBLIC_.
#
# Create a .env file in the root directory and populate with your non-secret
# Firebase Web Client configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (from Firebase Console > Project Settings)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey123456789
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hbplus-auth-assessment.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hbplus-auth-assessment
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hbplus-auth-assessment.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. Domain & Authorization Configuration
# ------------------------------------------------------------------------------
# Primary corporate domain to enforce (default: hbplus.fit)
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Safe Evaluation / Test Email Whitelist (Optional)
# For hiring assessors/interviewers who do not possess a real @hbplus.fit account.
# Comma-separated list of exact email addresses that should be granted test access.
# Example: EXPO_PUBLIC_TEST_ALLOWED_EMAILS=interviewer@gmail.com,evaluator@gmail.com
EXPO_PUBLIC_TEST_ALLOWED_EMAILS=

# Optional Admin Email Whitelist for Role-Based Access
# Accounts in this list receive the 'admin' role in the dashboard
EXPO_PUBLIC_ADMIN_EMAILS=admin@hbplus.fit

# ------------------------------------------------------------------------------
# 3. Optional Cloud Firestore Configuration
# ------------------------------------------------------------------------------
# Cloud Firestore is optional. Disabled by default ('false') when no database
# has been provisioned, preventing '@firebase/firestore: Database (default) not found'.
# Set to 'true' only if Cloud Firestore is provisioned in Firebase Console.
EXPO_PUBLIC_ENABLE_FIRESTORE=false
