rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if user is authenticated with Google and has a verified email
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Helper: checks if user has official @hbplus.fit domain
    function isAuthorizedDomain() {
      return isAuthenticated() &&
             request.auth.token.email.matches('.*@hbplus\\.fit$');
    }

    // Users Collection: Users may only read and write their own document if they belong to @hbplus.fit
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId && isAuthorizedDomain();
      allow create, update: if isAuthenticated() &&
                            request.auth.uid == userId &&
                            isAuthorizedDomain();
      allow delete: if false; // Disallow document deletion by clients
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
